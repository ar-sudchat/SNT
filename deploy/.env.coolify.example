# KruScan — environment variables for the Coolify stack.
# Paste into Coolify -> Resource -> Environment Variables (NOT committed with real values).
# Vars named SERVICE_* are Coolify "magic" vars: Coolify generates them itself;
# you normally leave them alone (listed here only for reference / non-Coolify use).

# ---------- PostgreSQL (internal container "postgres", never exposed) ----------
POSTGRES_USER=kruscan
POSTGRES_DB=kruscan
# Generated by Coolify. Outside Coolify: openssl rand -hex 24
SERVICE_PASSWORD_POSTGRES=
# Built automatically in the compose file from the 3 values above:
#   DATABASE_URL=postgresql://kruscan:<pw>@postgres:5432/kruscan?schema=public
#   DIRECT_URL=  (same; no pooler on self-host, Prisma needs it because schema declares directUrl)

# ---------- Auth ----------
# Generated by Coolify (new value = all old tokens/sessions invalid -> that is the point: rotate!)
SERVICE_BASE64_64_JWT=
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
# bcrypt hash of the NEW admin password. Generate (in backend/ folder, bcrypt/bcryptjs installed):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'YourNewPassword'
# CAVEAT: hash looks like $2b$12$.... Coolify/compose treat "$" as variable interpolation.
#   -> In Coolify tick "Is Literal?" (or escape every $ as $$):  $$2b$$12$$....
#   Verify after deploy: the container must see a value starting with $2b$ (60 chars).
ADMIN_PASSWORD_HASH=

# Login brute-force limit
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=900000

# ---------- Parent links ----------
# Generated by Coolify. Rotating it invalidates every previously sent parent link.
# To KEEP old links working, override PARENT_LINK_SECRET in compose with the old value instead.
SERVICE_BASE64_64_PARENTLINK=
PARENT_LINK_DAYS=
# PARENT_LINK_BASE_URL and FRONTEND_URL are set to SERVICE_FQDN_FRONTEND
# (e.g. https://kruscan.203-0-113-10.sslip.io). Set a real domain later in Coolify.

# ---------- Public URL (Coolify magic) ----------
# Coolify fills this; edit it in the "frontend" service Domains field.
# Use https:// so Traefik issues a Let's Encrypt cert — camera scanning needs HTTPS.
SERVICE_FQDN_FRONTEND=

# ---------- AI assistant (optional) ----------
AI_PROVIDER=anthropic          # anthropic | openai | gemini (empty = AI off)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Fixed in compose ----------
# NODE_ENV=production
# PORT=5001
