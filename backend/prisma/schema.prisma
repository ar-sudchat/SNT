// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User table for authentication
model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique
  googleSub String?  @unique
  password  String
  role      Role     @default(TEACHER)
  teacherId Int?     @unique
  studentId Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile (all optional, additive)
  avatar        String?   @db.Text // data:image/(png|jpeg|webp);base64 ≤150KB
  avatarPreset  String?
  displayName   String?
  bio           String?
  accent        String?
  passwordSetAt DateTime? // set when the admin changes password in-app (then DB hash wins over env)

  teacher Teacher? @relation("LegacyTeacherLogin", fields: [teacherId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  aiConversations AiConversation[]
  memberships     Membership[]
  teacherProfiles Teacher[]        @relation("TeacherAccount") // one per group (tenant) the user teaches in
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// AcademicYear table (ปีการศึกษา)
model AcademicYear {
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  id        Int       @id @default(autoincrement())
  year      String // เช่น "2567", "2568"
  name      String? // ชื่อเต็ม เช่น "ปีการศึกษา 2567"
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  classes  Class[]
  subjects Subject[]

  @@unique([tenantId, year])
  @@index([tenantId])
}

// Grade table (ชั้นปี)
model Grade {
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  gradeName   String
  description String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes  Class[]
  subjects Subject[]

  @@unique([tenantId, gradeName])
  @@index([tenantId])
}

// Class table (ห้องเรียน)
model Class {
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  className      String
  gradeId        Int
  teacherId      Int? // ครูประจำชั้น
  academicYearId Int?
  capacity       Int      @default(40)
  description    String?
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grade             Grade              @relation(fields: [gradeId], references: [id])
  homeTeacher       Teacher?           @relation("HomeClass", fields: [teacherId], references: [id])
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id])
  students          Student[]
  assessmentRecords AssessmentRecord[]
  taskRooms         TaskRoom[]

  @@unique([tenantId, className])
  @@index([tenantId])
}

// Student table (นักเรียน)
model Student {
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  id            Int      @id @default(autoincrement())
  studentCode   String
  studentNumber Int? // เลขที่ในห้อง
  name          String
  classId       Int
  email         String?
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class            Class             @relation(fields: [classId], references: [id])
  qrcodes          QRCode[]
  submissions      Submission[]
  assessmentScores AssessmentScore[]
  attendances      Attendance[]
  dayAttendances   DayAttendance[]
  absenceNotices   AbsenceNotice[]
  user             User?

  @@unique([tenantId, studentCode])
  @@index([tenantId])
}

// Teacher table (ครู)
model Teacher {
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  teacherCode String
  name        String
  email       String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Account that acts as this teacher in this group (set for group members; legacy teachers use User.teacherId)
  userId  Int?
  account User? @relation("TeacherAccount", fields: [userId], references: [id], onDelete: SetNull)

  homeClass         Class[]            @relation("HomeClass")
  subjects          Subject[]
  tasks             Task[]             @relation("CreatedBy")
  submissions       Submission[]       @relation("ReviewedBy")
  assessmentRecords AssessmentRecord[]
  user              User?              @relation("LegacyTeacherLogin")

  @@unique([tenantId, teacherCode])
  @@index([tenantId, userId]) // not @@unique: `db push` on deploy refuses new unique constraints; ensureTeacherFor keeps it 1:1
  @@index([tenantId])
}

// Subject table (วิชา)
model Subject {
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  subjectCode    String
  subjectName    String
  teacherId      Int
  gradeId        Int?
  academicYearId Int?
  description    String?
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher           Teacher            @relation(fields: [teacherId], references: [id])
  grade             Grade?             @relation(fields: [gradeId], references: [id])
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id])
  tasks             Task[]
  qrcodes           QRCode[]
  attendances       Attendance[]
  absenceNotices    AbsenceNotice[]
  assessmentRecords AssessmentRecord[]

  @@unique([tenantId, subjectCode])
  @@index([tenantId])
}

// Task table (งาน)
model Task {
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  id          Int         @id @default(autoincrement())
  subjectId   Int
  taskName    String
  taskNumber  Int
  description String?
  deadline    DateTime?
  scoringType ScoringType @default(SUBMISSION_ONLY) // ประเภทการให้คะแนน
  maxScore    Float? // คะแนนเต็ม (ใช้เมื่อ scoringType = SCORED)
  status      Status      @default(ACTIVE)
  createdById Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id])
  createdBy   Teacher      @relation("CreatedBy", fields: [createdById], references: [id])
  submissions Submission[]
  rooms       TaskRoom[] // ห้องที่ได้งานนี้ · ไม่มีแถว = ทุกห้องของชั้น

  @@unique([subjectId, taskNumber])
  @@index([tenantId])
}

// งานหนึ่งชิ้นลงได้หลายห้องในชั้นเดียวกัน
model TaskRoom {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  taskId   Int
  classId  Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([taskId, classId])
  @@index([tenantId])
  @@index([classId])
}

// ประเภทการให้คะแนน
enum ScoringType {
  SUBMISSION_ONLY // ส่ง/ไม่ส่ง
  PASS_FAIL // ผ่าน/ไม่ผ่าน
  SCORED // คิดคะแนน
}

// QRCode table
model QRCode {
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  id          Int       @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  qrcodeData  String
  qrcodeImage String? // Base64 or URL
  status      Status    @default(ACTIVE)
  printedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
  @@unique([tenantId, qrcodeData])
  @@index([tenantId])
}

// Submission table (การส่งงาน)
model Submission {
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  id           Int              @id @default(autoincrement())
  studentId    Int
  taskId       Int
  status       SubmissionStatus @default(NOT_SUBMITTED)
  score        Float? // คะแนนที่ได้ (ใช้เมื่อ task.scoringType = SCORED)
  submitDate   DateTime?
  reviewDate   DateTime?
  reviewedById Int?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student  @relation(fields: [studentId], references: [id])
  task       Task     @relation(fields: [taskId], references: [id])
  reviewedBy Teacher? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@unique([studentId, taskId])
  @@index([tenantId])
}

enum Status {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// ประวัติแชทผู้ช่วย AI (ต่อผู้ใช้)
model AiConversation {
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  id        Int         @id @default(autoincrement())
  userId    Int
  title     String
  classId   Int?
  subjectId Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
  @@index([tenantId])
}

model AiMessage {
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String // 'user' | 'assistant'
  content        String         @db.Text
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

// ---------- Multi-tenant (SaaS) ----------
model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique // internal only (auto-generated for groups)
  name        String
  joinCode    String?  @unique // XXX-XXX, teachers join with it
  kind        String   @default("group")
  plan        String   @default("free")
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_DELETE
  aiEnabled   Boolean  @default(true)
  docSettings Json? // บันทึกหลังแผน: ชื่อโรงเรียนและผู้ลงนามในไฟล์ Word
  createdAt   DateTime @default(now())

  memberships         Membership[]
  invites             Invite[]
  auditLogs           AuditLog[]
  academicYears       AcademicYear[]
  grades              Grade[]
  classes             Class[]
  students            Student[]
  teachers            Teacher[]
  subjects            Subject[]
  tasks               Task[]
  qrcodes             QRCode[]
  submissions         Submission[]
  aiConversations     AiConversation[]
  aiMessages          AiMessage[]
  assessmentTemplates AssessmentTemplate[]
  assessmentRecords   AssessmentRecord[]
  assessmentScores    AssessmentScore[]
  taskRooms           TaskRoom[]
  attendances         Attendance[]
  dayAttendances      DayAttendance[]
  absenceNotices      AbsenceNotice[]
}

enum TenantRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model Membership {
  id        Int        @id @default(autoincrement())
  userId    Int
  tenantId  String
  role      TenantRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Invite {
  id         Int        @id @default(autoincrement())
  tenantId   String
  email      String?
  role       TenantRole
  token      String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  String
  userId    Int?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------- บันทึกหลังแผน (lesson log)
// Template = criteria x scale -> total -> quality level. kind NOTE = บันทึกผลหลังการสอน (text, per class).
// Built-ins (key note/behav/act/work/trait/comp) are seeded per group on first use; custom ones use key "c-<n>".
model AssessmentTemplate {
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  id           Int      @id @default(autoincrement())
  key          String
  name         String
  kind         String // NOTE (built-in text form) | RUBRIC (per student, optional class questions) | CLASS (class questions only)
  maxScore     Int      @default(3)
  useAverage   Boolean  @default(false)
  responseType String   @default("SCORE") // per-student answer: SCORE | PASSFAIL | CHECK | TEXT
  classFields  Json     @default("[]") // class-level questions: [{ key, label, type, options? }]
  criteria     Json     @default("[]") // [{ label, short, source? }]  source "scan" = can fill from KruScan submissions
  levels       Json     @default("[]") // [{ min, label }] min = fraction of full score, highest first
  isBuiltIn    Boolean  @default(false)
  createdById  Int? // Teacher.id
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records AssessmentRecord[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// One filled-in form for one class. Criteria/scale/levels are snapshotted so later template edits never change old records.
model AssessmentRecord {
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  id           Int      @id @default(autoincrement())
  templateId   Int
  classId      Int
  subjectId    Int?
  teacherId    Int?
  name         String // typed by the teacher: plan name / activity name / work name
  dateText     String   @default("") // as written on the paper, e.g. "3, 9, 10 มิ.ย. 69"
  assessedOn   DateTime @default(now()) // for sorting
  teachDates   DateTime[] @db.Date // ทุกวันที่สอน/ประเมิน (วันจริง ใช้คิวรี) · dateText เป็นแค่ข้อความแสดงผล
  dateFrom     DateTime?  @db.Date // วันแรก (ใช้กรองช่วงวันที่)
  dateTo       DateTime?  @db.Date // วันสุดท้าย
  kind         String // copied from template: NOTE | RUBRIC | CLASS
  templateName String
  responseType String   @default("SCORE")
  classFields  Json     @default("[]")
  classAnswers Json? // { [fieldKey]: answer }
  header       Json? // NOTE: { planNo, unitNo, unitName }
  note         Json? // NOTE: { pct, outcome, problems: [], fixes: [], extra }
  criteria     Json     @default("[]")
  maxScore     Int      @default(3)
  useAverage   Boolean  @default(false)
  levels       Json     @default("[]")
  status       String   @default("DRAFT") // DRAFT | DONE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template AssessmentTemplate @relation(fields: [templateId], references: [id])
  class    Class              @relation(fields: [classId], references: [id])
  subject  Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher  Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  scores   AssessmentScore[]

  @@index([tenantId, classId])
  @@index([tenantId])
  @@index([tenantId, dateFrom, dateTo])
}

model AssessmentScore {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  recordId  Int
  studentId Int
  values    Json     @default("[]") // int per criterion, 1..maxScore
  updatedAt DateTime @updatedAt

  record  AssessmentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([recordId, studentId])
  @@index([tenantId])
}

// เช็คการเข้าเรียน · 1 แถว = นักเรียน 1 คน ในวิชา 1 วิชา ใน 1 วัน
// date เก็บเป็นข้อความ YYYY-MM-DD (วันตามเวลาไทย) · วันที่มีแถวของวิชานั้น = วันที่มีคาบเรียน
enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  id         Int              @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  date       String
  status     AttendanceStatus
  markedById Int? // ครูที่บันทึก (Teacher.id)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
  @@index([tenantId])
  @@index([subjectId, date])
}

// เช็คมาเรียนรายวัน (ไม่ผูกวิชา) · สแกนเอกสารวิชาไหนก็ได้ = มาโรงเรียนวันนั้น
// ไม่มีแถว = ไม่มา · วันที่ห้องนั้นมีคนถูกสแกนอย่างน้อย 1 คน = วันที่มีเรียนของห้อง
model DayAttendance {
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  studentId  Int
  date       String
  markedById Int?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([date])
}

// แจ้งผู้ปกครองว่านักเรียนไม่มาเรียน (วิชา/วัน) · แสดงในลิงก์ผู้ปกครอง /p/:token · ไม่มีบริการส่งข้อความภายนอก
model AbsenceNotice {
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  date        String
  createdById Int? // ครูที่กดแจ้ง (Teacher.id)
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
  @@index([tenantId])
  @@index([studentId, date])
}
