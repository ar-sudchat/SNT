# Neon PostgreSQL Database
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="12h"

# Admin login (REQUIRED in production). Hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-strong-password'
# If ADMIN_PASSWORD_HASH is unset the server falls back to the legacy default and logs a warning.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-your-bcrypt-hash"

# Login rate limit (optional; defaults 5 fails / 15 min per IP+username)
# LOGIN_MAX_FAILS=5
# LOGIN_WINDOW_MS=900000

# Server
PORT=5001
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-url.koyeb.app

# AI assistant (optional) — ใส่คีย์อย่างน้อยหนึ่งตัวเพื่อเปิดใช้
# AI_PROVIDER=anthropic   # anthropic | gemini | openai (ไม่ตั้ง = ใช้ตัวแรกที่มีคีย์ตามลำดับนี้)
# AI_MODEL=               # ไม่ตั้ง = anthropic: claude-sonnet-5-5, gemini: gemini-2.5-flash, openai: gpt-5-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ลิงก์ติดตามสำหรับผู้ปกครอง (ตั้งค่าสุ่มยาว ≥32 ไบต์ใน production)
# PARENT_LINK_SECRET=""
# PARENT_LINK_DAYS=120
# PARENT_LINK_BASE_URL="https://your-frontend-domain"
